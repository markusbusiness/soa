{
  "uid": "movie-analytics",
  "title": "Online Cinema Analytics",
  "tags": [
    "dz5",
    "clickhouse"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Retention Cohort Heatmap",
      "description": "Когорта = день первого VIEW_STARTED пользователя. Day N = доля когорты, активная через N дней. Цвет: 0% красный, 50% и выше зелёный.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 18
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    toString(cohort_date) AS `Когорта`,\n    max(cohort_size) AS `Пользователей`,\n    round(100 * maxIf(retention_rate, day_offset = 0), 1) AS `Day 0`,\n    round(100 * maxIf(retention_rate, day_offset = 1), 1) AS `Day 1`,\n    round(100 * maxIf(retention_rate, day_offset = 2), 1) AS `Day 2`,\n    round(100 * maxIf(retention_rate, day_offset = 3), 1) AS `Day 3`,\n    round(100 * maxIf(retention_rate, day_offset = 4), 1) AS `Day 4`,\n    round(100 * maxIf(retention_rate, day_offset = 5), 1) AS `Day 5`,\n    round(100 * maxIf(retention_rate, day_offset = 6), 1) AS `Day 6`,\n    round(100 * maxIf(retention_rate, day_offset = 7), 1) AS `Day 7`\nFROM analytics.agg_retention_cohort FINAL\nWHERE cohort_size > 0 AND cohort_date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY cohort_date\nORDER BY cohort_date",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "minWidth": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Day 0"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Day [1-7]$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 50
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-RdYlGr"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DAU / WAU / MAU",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(metric_date) AS time,\n       maxIf(value, metric_name = 'dau') AS DAU,\n       maxIf(value, metric_name = 'wau') AS WAU,\n       maxIf(value, metric_name = 'mau') AS MAU\nFROM analytics.agg_daily_metrics FINAL\nWHERE metric_name IN ('dau', 'wau', 'mau') AND metric_date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Конверсия просмотра (VIEW_FINISHED / VIEW_STARTED)",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(metric_date) AS time, 100 * value AS `Конверсия`\nFROM analytics.agg_daily_metrics FINAL\nWHERE metric_name = 'view_conversion' AND metric_date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Среднее время просмотра (VIEW_FINISHED)",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(metric_date) AS time, value AS `Среднее время`\nFROM analytics.agg_daily_metrics FINAL\nWHERE metric_name = 'avg_view_seconds' AND metric_date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Топ-10 фильмов по просмотрам",
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT movie_id, sum(views) AS views\nFROM analytics.agg_movie_daily FINAL\nWHERE metric_date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY movie_id\nORDER BY views DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^views$/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Просмотры по устройствам",
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toString(device_type) AS device, sum(views) AS views\nFROM analytics.agg_device_daily FINAL\nWHERE metric_date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY device\nORDER BY device",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^views$/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
