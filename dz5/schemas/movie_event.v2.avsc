{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "cinema.events.v1",
  "doc": "Действие пользователя онлайн-кинотеатра. Ключ сообщения в Kafka: user_id",
  "fields": [
    {
      "name": "event_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "user_id",
      "type": "string"
    },
    {
      "name": "movie_id",
      "type": "string"
    },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "VIEW_STARTED",
          "VIEW_FINISHED",
          "VIEW_PAUSED",
          "VIEW_RESUMED",
          "LIKED",
          "SEARCHED"
        ]
      }
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "UTC"
    },
    {
      "name": "device_type",
      "type": {
        "type": "enum",
        "name": "DeviceType",
        "symbols": [
          "MOBILE",
          "DESKTOP",
          "TV",
          "TABLET"
        ]
      }
    },
    {
      "name": "session_id",
      "type": "string"
    },
    {
      "name": "progress_seconds",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Заполняется для VIEW_*"
    },
    {
      "name": "search_query",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Текст запроса для SEARCHED, добавлено в v2"
    }
  ]
}
